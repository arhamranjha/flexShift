PORT=4000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/flexshift_db?schema=public"
# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Browser sessions are HttpOnly cookies. Secure is on in production; set COOKIE_SAMESITE=none (HTTPS only) if the
# apps and the API are on different sites.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Where compliance documents are stored (local-disk adapter; see src/storage/storage.service.ts)
UPLOAD_DIR="./uploads"

# Staff-bank shifts widen Tier 1 -> 2 -> 3 -> marketplace after this many minutes each
CASCADE_DELAY_MINUTES=60

# Behind a reverse proxy set this (e.g. 1) so rate limiting sees the real client IP
# TRUST_PROXY=1
# Swagger is on outside production; set true to expose it in production too
# ENABLE_SWAGGER=true

# Tests use their own database, rebuilt on every run (name must contain "test")
# TEST_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/flexshift_test?schema=public"

# Email copies of important notifications. off (default) | smtp | json (builds messages in memory, sends nothing)
EMAIL_DRIVER=off
# SMTP_URL="smtps://user:password@smtp.example.com"
# EMAIL_FROM="FlexShift <no-reply@your-domain.com>"
# Where the links inside emails point
ADMIN_APP_URL="http://localhost:3000"
WORKER_APP_URL="http://localhost:3001"
