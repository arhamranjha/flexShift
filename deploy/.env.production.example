# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your domain: the stack serves app.<DOMAIN>, work.<DOMAIN> and api.<DOMAIN>
DOMAIN=example.com

# Generate both with:  openssl rand -base64 36
POSTGRES_PASSWORD=
JWT_SECRET=

# --- optional ---------------------------------------------------------------
# Email copies of important notifications (off | smtp)
EMAIL_DRIVER=off
# SMTP_URL=smtps://user:password@smtp.example.com
# EMAIL_FROM=FlexShift <no-reply@example.com>

# Documents live on the server's disk (a Docker volume, included in backups). To use S3-compatible storage instead
# (AWS S3, Cloudflare R2, Hetzner Object Storage) set these:
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Minutes between staff-bank cascade steps (Tier 1 -> 2 -> 3 -> marketplace)
CASCADE_DELAY_MINUTES=60
