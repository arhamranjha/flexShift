{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-api": {
      "root": "apps/backend-api",
      "framework": "nestjs"
    },
    "web-admin": {
      "root": "apps/web-admin",
      "framework": "nextjs"
    },
    "worker-portal": {
      "root": "apps/worker-portal",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend-api" } },
    { "source": "/worker/(.*)", "destination": { "service": "worker-portal" } },
    { "source": "/(.*)", "destination": { "service": "web-admin" } }
  ]
}
